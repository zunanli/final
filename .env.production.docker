# 生产环境 Docker 部署配置
# 使用方式: docker-compose --env-file .env.production.docker -f docker-compose.production.yml up -d

# 应用镜像配置
IMAGE=your-registry/my-ssr-app
TAG=latest

# 数据库配置
DB_NAME=myapp_production
DB_USER=myapp_user
DB_PASSWORD=MyApp2024!SecurePass#789
MYSQL_ROOT_PASSWORD=RootAdmin2024!MySQL#456

# 监控配置
GRAFANA_PASSWORD=GrafanaAdmin2024!Monitor#123

# 注意：在真实生产环境中，请：
# 1. 使用更强的密码
# 2. 考虑使用 Docker secrets 或外部密钥管理
# 3. 定期轮换密码
# 4. 限制网络访问